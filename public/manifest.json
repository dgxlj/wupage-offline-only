{
  "manifest_version": 3,
  "name": "WuPage（不可说的秘密版）",
  "description": "纯本地 Bergamot 翻译及 PaddleOCR；保留模型下载，不提供在线翻译或 LLM API。支持本地 HTML、TXT 及在线 TXT 翻译。",
  "default_locale": "en",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "WuPage（不可说的秘密版）V1.3"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "css": [
        "provider-picker.css",
        "floating.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "frame-bootstrap.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "permissions": [
    "storage",
    "offscreen",
    "contextMenus",
    "activeTab",
    "webNavigation",
    "declarativeNetRequestWithHostAccess"
  ],
  "sandbox": {
    "pages": [
      "ocr-sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'self'; connect-src 'self' data: chrome-extension:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ocr-runtime/*",
        "frame-content.js",
        "_locales/en/messages.json",
        "_locales/zh_CN/messages.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
